{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 120,
      "includeFiles": "{server.py,kuccps_2025.json}"
    }
  },
  "rewrites": [
    {
      "source": "/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/analyze",
      "destination": "/api/analyze"
    },
    {
      "source": "/course-facts",
      "destination": "/api/course-facts"
    }
  ]
}
